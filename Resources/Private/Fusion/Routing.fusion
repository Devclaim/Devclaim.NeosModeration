Devclaim.NeosModeration.ModerationController {
    index = afx`
        <Devclaim.NeosModeration:View.Index
            cases={cases}
            types={types}
            selectedStatus={selectedStatus}
            selectedType={selectedType}
        />
    `

    show = afx`
        <Devclaim.NeosModeration:View.Show
            case={case}
            presentation={presentation}
            privateMetadata={privateMetadata}
            auditEntries={auditEntries}
            csrfToken={csrfToken}
        />
    `
}
