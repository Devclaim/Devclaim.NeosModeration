prototype(Devclaim.NeosModeration:View.Index) < prototype(Neos.Fusion:Component) {
    cases = null
    types = null
    selectedStatus = 'pending'
    selectedType = ''

    renderer = afx`
        <div class="neos-content neos-container-fluid">
            <h1>Moderation</h1>
            <form method="get" class="neos-form">
                <label for="moderation-status">Status</label>
                <select id="moderation-status" name="moduleArguments[status]">
                    <option value="pending" selected={props.selectedStatus == 'pending'}>Pending</option>
                    <option value="approved" selected={props.selectedStatus == 'approved'}>Approved</option>
                    <option value="rejected" selected={props.selectedStatus == 'rejected'}>Rejected</option>
                    <option value="all" selected={props.selectedStatus == 'all'}>All</option>
                </select>
                <label for="moderation-type">Type</label>
                <select id="moderation-type" name="moduleArguments[type]">
                    <option value="">All accessible types</option>
                    <Neos.Fusion:Loop items={props.types} itemName="type" iterationName="typeIterator">
                        <option value={type.key} selected={props.selectedType == type.key}>{String.htmlSpecialChars(type.label)}</option>
                    </Neos.Fusion:Loop>
                </select>
                <button class="neos-button neos-button-primary" type="submit">Filter</button>
            </form>

            <table class="neos-table">
                <thead>
                    <tr><th>Identifier</th><th>Type</th><th>Status</th><th>Locale</th><th>Submitted</th></tr>
                </thead>
                <tbody>
                    <Neos.Fusion:Loop items={props.cases} itemName="case" iterationName="caseIterator">
                        <Devclaim.NeosModeration:Component.CaseRow case={case} />
                    </Neos.Fusion:Loop>
                </tbody>
            </table>
        </div>
    `
}
