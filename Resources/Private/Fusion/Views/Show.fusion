prototype(Devclaim.NeosModeration:View.Show) < prototype(Neos.Fusion:Component) {
    case = null
    presentation = null
    privateMetadata = null
    auditEntries = null
    csrfToken = ''

    backUri = Neos.Fusion:UriBuilder {
        action = 'index'
    }
    approveUri = Neos.Fusion:UriBuilder {
        action = 'approve'
    }
    rejectUri = Neos.Fusion:UriBuilder {
        action = 'reject'
    }

    renderer = afx`
        <div class="neos-content neos-container-fluid">
            <p><a class="neos-button" href={props.backUri}>Back to cases</a></p>
            <h1>{String.htmlSpecialChars(props.presentation.title)}</h1>
            <dl>
                <dt>Identifier</dt><dd>{String.htmlSpecialChars(props.case.identifier)}</dd>
                <dt>Type</dt>
                <dd>{String.htmlSpecialChars(props.case.typeLabel)} ({String.htmlSpecialChars(props.case.typeKey)})</dd>
                <dt>Status</dt><dd>{String.htmlSpecialChars(props.case.status)}</dd>
                <dt>Locale</dt><dd>{String.htmlSpecialChars(props.case.locale)}</dd>
                <dt>Submitted</dt><dd>{String.htmlSpecialChars(props.case.submittedAt)}</dd>
                <Neos.Fusion:Loop items={props.presentation.fields} itemName="field" iterationName="fieldIterator">
                    <Devclaim.NeosModeration:Component.PresentationField field={field} />
                </Neos.Fusion:Loop>
            </dl>

            <Neos.Fusion:Fragment @if={props.privateMetadata != null}>
                <h2>Private submitter metadata</h2>
                <pre>{String.htmlSpecialChars(props.privateMetadata)}</pre>
            </Neos.Fusion:Fragment>

            <h2>Decision</h2>
            <Neos.Fusion:Fragment @if={props.case.status == 'pending'}>
                <form method="post" action={props.approveUri} class="neos-form">
                    <input type="hidden" name="__csrfToken" value={props.csrfToken} />
                    <input type="hidden" name="moduleArguments[caseId]" value={props.case.identifier} />
                    <label for="approve-reason">Optional decision reason</label>
                    <textarea id="approve-reason" name="moduleArguments[reason]" maxlength="4000"></textarea>
                    <button class="neos-button neos-button-success" type="submit">Approve</button>
                </form>
                <form method="post" action={props.rejectUri} class="neos-form">
                    <input type="hidden" name="__csrfToken" value={props.csrfToken} />
                    <input type="hidden" name="moduleArguments[caseId]" value={props.case.identifier} />
                    <label for="reject-reason">Optional rejection reason</label>
                    <textarea id="reject-reason" name="moduleArguments[reason]" maxlength="4000"></textarea>
                    <button class="neos-button neos-button-danger" type="submit">Reject</button>
                </form>
            </Neos.Fusion:Fragment>
            <dl @if={props.case.status != 'pending'}>
                <dt>Decided</dt><dd>{String.htmlSpecialChars(props.case.decidedAt)}</dd>
                <dt>Moderator</dt><dd>{String.htmlSpecialChars(props.case.moderatorIdentifier)}</dd>
                <dt>Reason</dt><dd>{String.htmlSpecialChars(props.case.decisionReason)}</dd>
                <dt>External reference</dt><dd>{String.htmlSpecialChars(props.case.externalReference)}</dd>
            </dl>

            <h2>Audit history</h2>
            <table class="neos-table">
                <thead><tr><th>Recorded</th><th>Event</th><th>Actor</th><th>Context</th></tr></thead>
                <tbody>
                    <Neos.Fusion:Loop items={props.auditEntries} itemName="entry" iterationName="auditIterator">
                        <Devclaim.NeosModeration:Component.AuditRow entry={entry} />
                    </Neos.Fusion:Loop>
                </tbody>
            </table>
        </div>
    `
}
