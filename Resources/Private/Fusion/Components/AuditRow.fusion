prototype(Devclaim.NeosModeration:Component.AuditRow) < prototype(Neos.Fusion:Component) {
    entry = null

    renderer = afx`
        <tr>
            <td>{String.htmlSpecialChars(props.entry.recordedAt)}</td>
            <td>{String.htmlSpecialChars(props.entry.event)}</td>
            <td>{String.htmlSpecialChars(props.entry.actor)}</td>
            <td><pre>{String.htmlSpecialChars(props.entry.context)}</pre></td>
        </tr>
    `
}
