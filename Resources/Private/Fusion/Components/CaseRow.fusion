prototype(Devclaim.NeosModeration:Component.CaseRow) < prototype(Neos.Fusion:Component) {
    case = null

    @private {
        showUri = Neos.Fusion:UriBuilder {
            action = 'show'
            arguments.caseId = ${props.case.identifier}
        }
    }

    renderer = afx`
        <tr>
            <td><a href={private.showUri}>{String.htmlSpecialChars(props.case.identifier)}</a></td>
            <td>{String.htmlSpecialChars(props.case.typeLabel)}</td>
            <td>{String.htmlSpecialChars(props.case.status)}</td>
            <td>{String.htmlSpecialChars(props.case.locale)}</td>
            <td>{String.htmlSpecialChars(props.case.submittedAt)}</td>
        </tr>
    `
}
